{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // "/__scheduled": solo per i test (wrangler dev --test-scheduled avvia la pulizia notturna); in produzione dà 404.
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledgy",
      "database_id": "48dc70af-3f0d-46ab-a832-e9661ccf63b2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 1 * * *"] },
  "observability": { "enabled": true }
}
